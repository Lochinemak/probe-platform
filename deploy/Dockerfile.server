# syntax=docker/dockerfile:1
# --- frontend ---
FROM --platform=$BUILDPLATFORM node:22-alpine AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json* ./
RUN npm install --no-fund --no-audit
COPY web/ ./
RUN npm run build

# --- agent binaries for every platform (served by the server for self-update);
#     32-bit MIPS is built softfloat so it runs on FPU-less SoCs like MT7621;
#     no TARGET* args here so buildx builds this stage once for all platforms ---
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS agents
ARG VERSION=dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN set -e; mkdir -p /out/agents; \
    for t in linux/amd64 linux/arm64 linux/arm/7 linux/arm/6 linux/386 linux/mipsle linux/mips linux/mips64le linux/riscv64 darwin/arm64 darwin/amd64 windows/amd64 freebsd/amd64; do \
      os=${t%%/*}; rest=${t#*/}; arch=${rest%%/*}; arm=""; variant=""; \
      case "$rest" in */*) arm=${rest#*/}; variant="v$arm";; esac; \
      ext=""; [ "$os" = windows ] && ext=".exe"; \
      CGO_ENABLED=0 GOOS=$os GOARCH=$arch GOARM=$arm GOMIPS=softfloat go build -trimpath \
        -ldflags "-s -w -X probe-platform/internal/buildinfo.Version=$VERSION -X probe-platform/internal/buildinfo.Variant=$variant" \
        -o /out/agents/probe-agent-$os-$arch$variant$ext ./cmd/agent; \
    done; \
    cp deploy/install-agent.sh deploy/install-agent-openwrt.sh /out/agents/; \
    cd /out/agents && sha256sum probe-agent-* > SHA256SUMS

# --- server ---
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG VERSION=dev
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web /src/web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w -X probe-platform/internal/buildinfo.Version=$VERSION" -o /out/probe-server ./cmd/server

# --- runtime ---
FROM alpine:3.21
LABEL org.opencontainers.image.source="https://github.com/Lochinemak/probe-platform"
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 probe
COPY --from=build /out/probe-server /usr/local/bin/probe-server
COPY --from=agents /out/agents /usr/share/probe-platform/agents
USER probe
VOLUME ["/data"]
ENV PROBE_LISTEN=:8080 PROBE_DATA_DIR=/data PROBE_AGENTS_DIR=/usr/share/probe-platform/agents
EXPOSE 8080
ENTRYPOINT ["probe-server"]
