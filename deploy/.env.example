# Shared secret agents use to connect. Generate one: openssl rand -hex 24
PROBE_AGENT_TOKEN=change-me
# Dashboard login. Leave empty only on a private network.
PROBE_ADMIN_PASSWORD=change-me-too
# Set true when nginx/caddy sits in front so agent IPs are read from X-Forwarded-For.
PROBE_TRUST_PROXY=false
PROBE_GEOIP_ONLINE=true
PROBE_RETAIN_DAYS=90
LOCAL_AGENT_NAME=tencent-gz
LOCAL_AGENT_LOCATION=广东 广州
LOCAL_AGENT_ISP=腾讯云
