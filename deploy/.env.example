# Copy to deploy/.env (git-ignored) and fill in. Never commit the result.
# Dashboard login. Leave empty only on a private network.
PROBE_ADMIN_PASSWORD=change-me-too
# Set true when nginx/caddy sits in front so agent IPs are read from X-Forwarded-For.
# PROBE_PROXY_HOPS is how many proxies are in front: only the entries they
# appended are trusted, so a client cannot claim someone else's address.
PROBE_TRUST_PROXY=false
PROBE_PROXY_HOPS=1
PROBE_GEOIP_ONLINE=true
PROBE_RETAIN_DAYS=90
# Optional agent on the same host (docker compose --profile local-agent up -d).
# Every node has its own token: start the server first, create the node on the
# dashboard (节点 → 接入新节点) and paste its token here.
LOCAL_AGENT_TOKEN=
LOCAL_AGENT_NAME=tencent-gz
LOCAL_AGENT_LOCATION=广东 广州
LOCAL_AGENT_ISP=腾讯云
# Only for upgrading an install from before per-node tokens: the old shared
# token, so existing nodes keep connecting until they have migrated (they do
# so on their own; then switch it off on the Agents page and delete this line).
# PROBE_AGENT_TOKEN=
