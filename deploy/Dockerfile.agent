# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG VERSION=dev
ARG TARGETOS TARGETARCH TARGETVARIANT
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# web/dist is only needed by the server; give the embed a stub so the module still compiles.
RUN mkdir -p web/dist && [ -f web/dist/index.html ] || echo '<html></html>' > web/dist/index.html
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOARM=${TARGETVARIANT#v} \
    go build -trimpath -ldflags "-s -w -X probe-platform/internal/buildinfo.Version=$VERSION" -o /out/probe-agent ./cmd/agent

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /out/probe-agent /usr/local/bin/probe-agent
# Runs as root by default so raw ICMP (ping/mtr) works; pass --cap-add NET_RAW
# and optionally --user if you drop privileges.
ENTRYPOINT ["probe-agent"]
