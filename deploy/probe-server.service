[Unit]
Description=probe-platform server (dashboard + agent hub)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/probe-server.env
ExecStart=/usr/local/bin/probe-server --data /var/lib/probe-server
Restart=always
RestartSec=3
DynamicUser=yes
StateDirectory=probe-server
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
