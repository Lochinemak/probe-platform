# /opt/probe-platform/.env  (chmod 600)
# Old shared agent token. Nodes have their own tokens now (created on the Agents
# page); this is only read so nodes installed with it keep working until they
# have migrated. Once the Agents page shows no node on the shared token, switch
# it off there and delete this line.
PROBE_AGENT_TOKEN=
PROBE_ADMIN_PASSWORD=
PROBE_AGENT_IMAGE=ghcr.91856478.xyz/lochinemak/probe-agent:latest
PROBE_RETAIN_DAYS=90
# Set by deploy.sh to the last deployed image tag (rollback: edit and `docker compose up -d`)
IMAGE_TAG=latest
